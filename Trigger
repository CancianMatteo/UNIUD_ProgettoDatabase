CREATE OR REPLACE FUNCTION check_car_act()
RETURNS TRIGGER AS $$
DECLARE
    data_distruzione_automobile DATE;
BEGIN
    SELECT data_distruzione INTO data_distruzione_automobile
    FROM Automobili
    WHERE ID_registrazione = NEW.auto_riferita;

    IF data_distruzione_automobile IS NOT NULL THEN
        RAISE EXCEPTION 'Errore: Non è possibile stipulare un atto riferito a un''auto distrutta';
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_check_car_act
BEFORE INSERT ON Atti_di_fornitura
FOR EACH ROW
EXECUTE FUNCTION check_car_act();



CREATE OR REPLACE FUNCTION check_privates()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.vecchio_privato = NEW.nuovo_privato THEN
        RAISE EXCEPTION 'Errore: Non è possibile stipulare un atto tra due privati se questi sono la stessa persona';
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_check_privates
BEFORE INSERT ON Atti_di_trasferimento
FOR EACH ROW
EXECUTE FUNCTION check_privates();



CREATE OR REPLACE FUNCTION check_privates()
RETURNS TRIGGER AS $$
BEGIN
     IF NEW.is_singolo_privato = TRUE THEN
        IF NEW.nome IS NULL OR NEW.cognome IS NULL OR NEW.cf IS NULL OR NEW.indirizzo IS NULL OR NEW.telefono IS NULL THEN
            RAISE EXCEPTION 'Errore: Un singolo privato deve avere nome, cognome, codice fiscale, indirizzo e telefono.';
        END IF;
    ELSE
        IF NEW.nome IS NOT NULL OR NEW.cognome IS NOT NULL OR NEW.cf IS NOT NULL OR NEW.indirizzo IS NOT NULL OR NEW.telefono IS NOT NULL THEN
            RAISE EXCEPTION 'Errore: Un gruppo di privati non può avere nome, cognome, codice fiscale, indirizzo o telefono.';
        END IF;
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_check_privates
BEFORE INSERT ON Privati
FOR EACH ROW
EXECUTE FUNCTION check_privates();
